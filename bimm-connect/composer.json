{
    "name": "bimmodeller/bimm-connect",
    "description": "BIMModeller BIMM_Connect Magento 2 module — REST API for the Revit plugin",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "magento/framework": ">=102.0",
        "magento/module-catalog": ">=104.0",
        "magento/module-customer": ">=103.0",
        "magento/module-webapi": ">=100.4",
        "magento/module-integration": ">=100.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.10",
        "magento/magento-coding-standard": ">=5"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "BIMM\\Connect\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BIMM\\Connect\\Test\\": "Test/"
        }
    }
}
